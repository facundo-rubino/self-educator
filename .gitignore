__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.env

# El store se versiona a propósito: en GitHub Actions cada corrida arranca de
# un checkout limpio, y sin historial el scorer `novelty` trata todo como
# nuevo — o sea, el brief repetiría las mismas noticias todas las mañanas.
# Lo que SÍ se ignora son los volcados de documentos crudos por corrida, que
# son lo único pesado y lo único regenerable.
store/corpus/*.json
!store/corpus/baseline.json

runs/

# Config local de Obsidian sobre kb/ — es de la máquina, no del repo.
kb/.obsidian/
