# Copiá esto a .env y completá lo que uses.
# Las etapas 1 y 2 (ingesta y señal) no necesitan ninguna credencial.
# Las etapas 3 y 4 (investigación y compilación) sí.

# DeepSeek — es el proveedor por defecto. Barato: centavos por mes.
DEEPSEEK_API_KEY=sk-...

# Anthropic — alternativa. Se elige con `provider: anthropic` en config.yaml.
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Ejemplo de fuente con credencial. Ver self_educator/sources/_template.py.
# MY_SOURCE_TOKEN=...
